.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Local runtime output; keep the directories in the tree with .gitkeep files.
logs/*
!logs/.gitkeep
artifacts/*
!artifacts/.gitkeep

# Durable local memory; schemas and .gitkeep files remain versioned.
memory/*/*
!memory/*/.gitkeep

# Local secrets and machine-specific overrides.
.env
.env.*
!.env.example
